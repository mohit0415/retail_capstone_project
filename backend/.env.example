APP_ENV=local
LOG_LEVEL=INFO

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_SMALL_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_STRONG_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
EMBEDDING_DIMENSIONS=1536

LLAMAPARSE_API_KEY=
VECTOR_TABLE_NAME=policy_kb
IMAGES_STORAGE_DIR=data/stored_images

POLICY_CORPUS_DIR=data/policies
BOOTSTRAP_CORPUS_ON_STARTUP=true
BOOTSTRAP_FAIL_FAST=false
UPLOAD_MAX_BYTES=20971520

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retail_compliance_db
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT_SECONDS=3.0
SQL_STATEMENT_TIMEOUT_MS=3000
SQL_ROW_LIMIT=200

JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

CONFIDENCE_THRESHOLD=0.75
MAX_REFLECTION_RETRIES=2
PANEL_REPAIR_PASSES=1
DEFAULT_TOKEN_BUDGET=12000
DEADLINE_SECONDS_STANDARD=4.0
DEADLINE_SECONDS_HYBRID=6.0
DEADLINE_SECONDS_AGENTIC=10.0
DEADLINE_SECONDS_HIGH_RISK=12.0

MAX_CHUNK_TOKENS=512
MAX_CHUNK_CHARS=2200
CHUNK_OVERLAP=40
CHUNK_OVERLAP_CHARS=200
MAX_TABLE_CHARS=5000
SEMANTIC_BUFFER_SIZE=1
SEMANTIC_BREAKPOINT_PERCENTILE=95

RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
RRF_K=60
FUSION_NUM_QUERIES=1
USE_AUTO_RETRIEVER=false
ENABLE_FLASHRANK_RERANK=true
FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
FLASHRANK_CACHE_DIR=
ENABLE_CITATION_SYNTHESIS=false

ENABLE_AGENTIC_PATH=true
AGENT_MAX_ITERATIONS=8
AGENTIC_MIN_SECONDS=3.0

MCP_ENABLED=true
MCP_REQUIRED=false
MCP_SERVER_URL=
MCP_ALLOWED_TOOLS=
MCP_TIMEOUT_SECONDS=30
MCP_MAX_OUTPUT_CHARS=6000

ENABLE_GUARDRAILS_AI=true
PII_ENTITIES=

AS_OF_DATE=2025-12-31

ESCALATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
APPLICATION_EMAIL=
REVIEWER_EMAIL=
REVIEWER_CONSOLE_URL=http://localhost:8000/review

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TRACING_ENABLED=false

RATE_LIMIT_STANDARD=30/minute
RATE_LIMIT_HIGH_RISK=10/minute
