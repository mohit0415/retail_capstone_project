APP_ENV=local
LOG_LEVEL=INFO
# Rotating log file (leave empty to log to the terminal only)
LOG_FILE=logs/rpids.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# Azure OpenAI. With the React frontend these are typed on the login page and
# sent to POST /auth/azure after the Auth0 login, so they can stay empty here.
# Fill them in only for Swagger / curl use without the frontend.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_SMALL_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_STRONG_DEPLOYMENT=gpt-4o
# The embedding model is also chosen on the login page (large / small); the vector
# width below is then re-derived from that choice at login (3-large=3072, 3-small=1536),
# so these two are only the value used before anyone has logged in.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o-mini
EMBEDDING_DIMENSIONS=3072

# Optional. LlamaParse is also typed on the login page, and a key given there wins,
# so leave this empty if uploads with tables/diagrams should be billed to whoever is
# logged in instead of to this server. Empty here AND on the login page = those uploads
# are refused with a message.
LLAMAPARSE_API_KEY=
VECTOR_TABLE_NAME=policy_kb
IMAGES_STORAGE_DIR=data/stored_images

POLICY_CORPUS_DIR=data/policies
BOOTSTRAP_CORPUS_ON_STARTUP=true
BOOTSTRAP_FAIL_FAST=false
UPLOAD_MAX_BYTES=20971520

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retail_compliance_db
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT_SECONDS=3.0
SQL_STATEMENT_TIMEOUT_MS=3000
SQL_ROW_LIMIT=200
ENABLE_GENERATED_SQL_FALLBACK=true

# ---- Auth0 (RBAC) ----
# Tokens are minted by Auth0, not by this backend. Same tenant / API as the
# practice-1 travel planner; the frontend .env carries the matching VITE_AUTH0_* values.
# Roles to create in the Auth0 dashboard and assign to users:
#   store_associate, store_manager, compliance_officer, legal_reviewer, admin
AUTH0_DOMAIN=dev-0iuzey7e1lc2ao5e.jp.auth0.com
API_AUDIENCE=https://api.stateful-agent.com
ALGORITHMS=RS256
# The Auth0 Action "add-roles-to-tokens" writes roles to "<namespace>/roles"
AUTH0_ROLE_NAMESPACE=https://stateful-agent.com

CONFIDENCE_THRESHOLD=0.75
MAX_REFLECTION_RETRIES=2
PANEL_REPAIR_PASSES=1

# ---- latency controls (defaults shown; see configs/settings.py) ----
# a hung Azure call is abandoned after this many seconds and retried
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# a repair pass is only started with at least this much deadline left
REPAIR_HEADROOM_SECONDS=8
# a RAG repair searches the same documents again, so one attempt is enough
RAG_REPAIR_ATTEMPTS=1
# a records (NL2SQL) repair keeps the rows and rewrites the answer once with the validator's defects
SQL_REPAIR_ATTEMPTS=1
# a drafted Low/Medium answer may still be validated this long after the deadline
VALIDATION_GRACE_SECONDS=15
# run intent + risk classifiers together; skip planner / rewrite calls that cannot change anything
PARALLEL_INTENT_AND_RISK=true
SKIP_PLANNER_FOR_SINGLE_PATH=true
SKIP_REWRITE_FOR_STANDALONE=true
DEFAULT_TOKEN_BUDGET=24000
DEADLINE_SECONDS_STANDARD=30.0
DEADLINE_SECONDS_HYBRID=45.0
DEADLINE_SECONDS_AGENTIC=75.0
DEADLINE_SECONDS_HIGH_RISK=90.0

CONVERSATION_WINDOW_TURNS=10
CONVERSATION_REWRITE_TURNS=5
CONVERSATION_SUMMARY_AFTER_TURNS=8

SLO_T1_P95_MS=6000
SLO_T2_P95_MS=9000
SLO_T3_P95_MS=20000
SLO_T4_P95_MS=27000
SLO_TOTAL_P95_MS=28000
SLO_PATH_TARGET_RATIO=0.85
SLO_WINDOW_HOURS=24

MAX_CHUNK_TOKENS=512
MAX_CHUNK_CHARS=2200
CHUNK_OVERLAP=40
CHUNK_OVERLAP_CHARS=200
MAX_TABLE_CHARS=5000
SEMANTIC_BUFFER_SIZE=1
SEMANTIC_BREAKPOINT_PERCENTILE=95

RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
RRF_K=60
FUSION_NUM_QUERIES=1
USE_AUTO_RETRIEVER=false
ENABLE_FLASHRANK_RERANK=true
FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
FLASHRANK_CACHE_DIR=
ENABLE_CITATION_SYNTHESIS=false

ENABLE_AGENTIC_PATH=true
AGENT_MAX_ITERATIONS=8
AGENTIC_MIN_SECONDS=3.0
HYBRID_MIN_SECONDS=2.0

MCP_ENABLED=true
MCP_REQUIRED=false
# External MCP server (README section 19). A command is spawned over stdio by the backend
# (needs `uv add duckduckgo-mcp-server`); an http://.../mcp URL connects to a server you run.
MCP_SERVER_URL=duckduckgo-mcp-server
MCP_ALLOWED_TOOLS=search,fetch_content
MCP_TIMEOUT_SECONDS=30
MCP_MAX_OUTPUT_CHARS=6000

ENABLE_GUARDRAILS_AI=true
PII_ENTITIES=EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD,IBAN_CODE,PERSON

AS_OF_DATE=2025-12-31

ESCALATION_EMAIL_ENABLED=false
# Send the e-mail only for escalations at or above this risk: Low | Medium | High
ESCALATION_EMAIL_MIN_RISK=High
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
APPLICATION_EMAIL=
REVIEWER_EMAIL=
REVIEWER_CONSOLE_URL=http://localhost:8000/review

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST and LANGFUSE_BASE_URL are interchangeable (EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com)
LANGFUSE_HOST=https://cloud.langfuse.com
TRACING_ENABLED=false

RATE_LIMIT_STANDARD=30/minute
RATE_LIMIT_HIGH_RISK=10/minute

# ---- Cost & latency: caching (src/cache) ----
# Answer cache in front of the graph; a hit skips every model call.
ENABLE_RESPONSE_CACHE=true
RESPONSE_CACHE_TTL_SECONDS=3600
RESPONSE_CACHE_MAX_ENTRIES=500
# Serve a cached answer when a new question is this similar (cosine) to a cached one.
# 1.0 = exact-match only.
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.95
# LangChain prompt->completion cache for temperature-0 model calls.
ENABLE_LLM_CACHE=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=2000
# Reuse the fused + reranked chunk list for an identical query and scope.
ENABLE_RETRIEVAL_CACHE=true
RETRIEVAL_CACHE_TTL_SECONDS=600
RETRIEVAL_CACHE_MAX_ENTRIES=500

# ---- Cost & latency: model routing (src/llm_routing) ----
# static | heuristic | cost_saver | quality_first
MODEL_ROUTING_STRATEGY=heuristic
ROUTING_COMPLEX_WORD_COUNT=50
# Under this much remaining deadline / token budget a routable node drops to the small tier.
ROUTING_LATENCY_PRESSURE_SECONDS=8.0
ROUTING_TOKEN_PRESSURE=6000
# Optional LiteLLM gateway (see litellm_config.yaml). Empty = call Azure OpenAI directly.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=dummy-key
LLM_GATEWAY_SMALL_MODEL=simple-agent
LLM_GATEWAY_STRONG_MODEL=complex-agent

# Local-only provider map (configs/model_routing.yaml): Azure or Ollama per tier.
# Leave false in every deployment - only Azure OpenAI is used then, and the flag is
# forced off automatically whenever APP_ENV is not "local".
USE_MODEL_ROUTING_YAML=false
MODEL_ROUTING_YAML_PATH=configs/model_routing.yaml
# USD per 1M tokens override, e.g. {"gpt-4o":{"input":2.5,"output":10},"gpt-4o-mini":{"input":0.15,"output":0.6}}
MODEL_PRICES_JSON=
# Soft per-request spend ceiling: exceeding it is logged as a warning, never blocked.
COST_BUDGET_USD_PER_REQUEST=0.05
